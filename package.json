    "lucide-react": "1.24.0",
    "geist": "1.7.2",
    "zod": "4.4.3",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0",
    "class-variance-authority": "0.7.1",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-tooltip": "1.2.12",
    "@radix-ui/react-separator": "1.1.11",
    "@radix-ui/react-slot": "1.3.0"
  },
  "devDependencies": {
